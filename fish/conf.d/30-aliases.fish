abbr dev 'nix develop ~/dev/dotfiles/nix-darwin/eryx/develop#dev'
abbr tools 'nix develop ~/dev/dotfiles/nix-darwin/eryx/develop#tools'

abbr gs 'git status'
abbr gl 'git log --graph --stat --oneline --decorate --source --pretty=format:"%Cblue %h %C(bold red)- <%an> -%C(green) (%ar)%C(auto)%d%n%C(yellow) %s"'
abbr gla 'git log --all --graph --stat --oneline --decorate --source --pretty=format:"%Cblue %h %C(bold red)- <%an> -%C(green) (%ar)%C(auto)%d%n%C(yellow) %s"'

abbr cl clear
abbr ex exit
abbr nv nvim

# ls
abbr l 'ls -Flha'
abbr ls 'eza --color --icons --group-directories-first -h -l -g -a --git --time-style=+%Y-%m-%d\ %H:%M'
abbr ll 'eza --color --icons --group-directories-first -h -l -a --no-filesize --no-user --no-permissions --no-time --git-ignore'
abbr tree 'eza --icons --tree --level=3 --git-ignore'

abbr tm tmux
abbr tma 'tmux attach'
abbr tmk 'tmux kill-server'
abbr tmks 'tmux kill-session -a'
abbr tmn 'tmux new-session'
abbr tms 'tmux new-session -s'

abbr lz 'lazygit'
abbr tl 'tldr'
